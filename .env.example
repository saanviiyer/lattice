# Copy this file to .env and fill in what you need. lattice runs FULLY with none of
# these set: no key means MOCK AI mode, and metadata lookups (CrossRef, arXiv) work
# with no key at all.

# --- AI (server-side only; never shipped to the browser) -------------------
# If unset, the server runs in MOCK MODE: the "explain highlight" and "synthesize
# highlights into a note" actions return realistic, structured results with no key.
ANTHROPIC_API_KEY=

# Optional: the contact address sent to Unpaywall and OpenAlex when looking up an
# open-access PDF for a paper added by DOI. Both ask for one so they can reach the
# caller about excessive use; neither treats it as authentication.
OA_CONTACT_EMAIL=

# Optional: override the server port (default 3001)
PORT=3001

# Optional in production when the frontend is hosted on another origin.
# Leave unset for the recommended single-origin deployment.
CORS_ORIGIN=
